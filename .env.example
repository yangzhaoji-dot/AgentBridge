# Relay server and local connector must use the same high-entropy token.
RELAY_SHARED_TOKEN=replace-with-a-long-random-token

# Local connector settings.
RELAY_URL=ws://127.0.0.1:8000/ws
LOCAL_AGENT_DEVICE_ID=local-dev
LOCAL_AGENT_DEFAULT_CWD=C:\Users\you\project
LOCAL_AGENT_ALLOWED_ROOTS=C:\Users\you\project
CODEX_BIN=.\node_modules\.bin\codex.cmd
HTTP_PROXY=http://127.0.0.1:12000
HTTPS_PROXY=http://127.0.0.1:12000
NO_PROXY=127.0.0.1,localhost
