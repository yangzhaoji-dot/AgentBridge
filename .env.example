# AgentBridge v0.2 remote Relay + local web-AI Connector
#
# Set these at runtime or in a server-side secret manager. Do not commit an
# actual pairing token. The Relay maps every device ID to its own token.
AGENTBRIDGE_PAIRINGS_JSON={"my-desktop":"replace-with-a-32-plus-character-random-token"}
AGENTBRIDGE_REQUEST_TIMEOUT=180

# Only on the computer that owns Edge/Chrome and the signed-in webpage AI.
AGENTBRIDGE_REMOTE_WS_URL=wss://bridge.example.com/ws/connector
AGENTBRIDGE_DEVICE_ID=my-desktop
AGENTBRIDGE_PAIRING_TOKEN=replace-with-the-token-for-my-desktop

# Optional: this protects the local extension-to-Connector link. If omitted,
# the Connector creates a local token in .runtime/ on first start.
# AGENTBRIDGE_TOKEN=replace-with-a-separate-local-token

# Legacy Web Local Agent prototype settings. These are not used by the active
# AgentBridge remote Relay/Connector path.
RELAY_SHARED_TOKEN=replace-with-a-long-random-token
RELAY_URL=ws://127.0.0.1:8000/ws
LOCAL_AGENT_DEVICE_ID=local-dev
LOCAL_AGENT_DEFAULT_CWD=C:\Users\you\project
LOCAL_AGENT_ALLOWED_ROOTS=C:\Users\you\project
CODEX_BIN=.\node_modules\.bin\codex.cmd
HTTP_PROXY=http://127.0.0.1:12000
HTTPS_PROXY=http://127.0.0.1:12000
NO_PROXY=127.0.0.1,localhost
